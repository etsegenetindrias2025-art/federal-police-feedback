/* ==========================================
   Ethiopian Federal Police - Official Theme
   ========================================== */

@font-face {
    font-family: 'Ebrima';
    src: url('../fonts/EBRIMA.TTF') format('truetype');
}

:root {
  --primary-color: id1b2a;     /* Deep Authority Navy */
  --secondary-color: #1b263b;    /* Slate Navy */
  --accent-gold: #c5a059;        /* Official Gold/Yellow Accent */
  --accent-gold-hover: #b08d46;
  --bg-light: #f4f6f9;           /* Clean Dashboard Background */
  --text-main: #333333;
  --text-light: #6c757d;
  --white: #ffffff;
  --transition-speed: 0.3s ease;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body, table, th, td {
  font-family: 'Ebrima', 'Abyssinica SIL', 'DejaVu Sans', sans-serif !important;
}

body {
  background-color: var(--primary-color);
  color: var(--white);
  line-height: 1.6;
  -webkit-text-size-adjust: 100%;
}

/* ==========================================
   Header & Navigation Styling (Responsive)
   ========================================== */
header {
  background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
  color: var(--white);
  padding: 1rem;
  border-bottom: 4px solid var(--accent-gold);
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  position: sticky;
  top: 0;
  z-index: 1000;
  flex-wrap: wrap;
  gap: 10px;
}

header .logo-area {
  display: flex;
  align-items: center;
  gap: 12px;
}

header img.police-logo {
  height: 45px;
  width: auto;
}

header h1 {
  font-size: 1.1rem;
  font-weight: 600;
  letter-spacing: 0.5px;
}

nav ul {
  list-style: none;
  display: flex;
  gap: 15px;
  flex-wrap: wrap;
}

nav ul li a {
  color: var(--white);
  text-decoration: none;
  font-weight: 500;
  font-size: 0.95rem;
  transition: color var(--transition-speed);
}

nav ul li a:hover {
  color: var(--accent-gold);
}

/* ==========================================
   Main Containers & Standard Cards
   ========================================== */
.container {
  max-width: 1100px;
  margin: 20px auto;
  padding: 0 15px;
}

.card {
  background: var(--secondary-color);
  border-radius: 8px;
  padding: 20px;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
  margin-bottom: 25px;
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-top: 4px solid var(--accent-gold);
}

.card h2 {
  color: var(--white);
  margin-bottom: 15px;
  font-size: 1.3rem;
  border-bottom: 2px solid rgba(255, 255, 255, 0.08);
  padding-bottom: 10px;
}

/* ==========================================
   Form Styling
   ========================================== */
.form-group {
  margin-bottom: 15px;
}

label {
  display: block;
  margin-bottom: 6px;
  font-weight: 600;
  color: var(--accent-gold);
  font-size: 0.8rem;
  text-transform: uppercase;
}

input[type="text"],
input[type="email"],
input[type="password"],
input[type="date"],
select,
textarea {
  width: 100%;
  padding: 12px 14px;
  background: #0d1b2a;
  border: 1px solid #334155;
  border-radius: 6px;
  font-size: 1rem;
  color: var(--white);
  transition: all var(--transition-speed);
}

input:focus, select:focus, textarea:focus {
  outline: none;
  border-color: var(--accent-gold);
  box-shadow: 0 0 0 3px rgba(197, 160, 89, 0.15);
}

/* ==========================================
   Official Action Buttons
   ========================================== */
button, .btn {
  background-color: var(--primary-color);
  color: var(--white);
  padding: 12px 20px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 6px;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: background var(--transition-speed), transform 0.1s ease;
  text-decoration: none;
  display: inline-block;
  text-align: center;
  width: 100%; /* Full width on mobile by default for ease of tapping */
}

button:hover, .btn:hover {
  background-color: var(--secondary-color);
  border-color: var(--accent-gold);
}

button:active, .btn:active {
  transform: scale(0.98);
}

.btn-gold {
  background-color: var(--accent-gold);
  color: var(--primary-color);
  border: none;
}

.btn-gold:hover {
  background-color: var(--accent-gold-hover);
  color: var(--white);
}

/* ==========================================
   Tables for Dashboards and Records (Scrollable)
   ========================================== */
.table-responsive {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  margin-top: 15px;
  border-radius: 6px;
}

table {
  width: 100%;
  border-collapse: collapse;
  background: #111b2d;
  min-width: 600px; /* Prevents cramped columns on small viewports */
}

table th, table td {
  padding: 12px 14px;
  text-align: left;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  color: #e5e7eb;
  font-size: 0.9rem;
}

table th {
  background-color: var(--primary-color);
  color: var(--accent-gold);
  font-weight: 600;
  text-transform: uppercase;
  font-size: 0.75rem;
}

table tr:hover {
  background-color: rgba(255, 255, 255, 0.02);
}

/* ==========================================
   Biometric & QR Side-by-Side View (Responsive)
   ========================================== */
.main-container {
  display: flex;
  flex-direction: column; /* Stacked by default on mobile phones */
  align-items: stretch;
  gap: 20px;
  padding: 20px 10px;
  max-width: 1200px;
  margin: 0 auto;
}

.bio-card {
  background-color: #111b2d;
  border: 1px solid #1e293b;
  border-radius: 12px;
  padding: 20px;
  width: 100%;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
}

.qr-image-box img {
  width: 160px;
  height: 160px;
  display: block;
  margin: 15px auto;
}

/* ==========================================
   Footer Design
   ========================================== */
footer {
  text-align: center;
  padding: 20px;
  background-color: var(--primary-color);
  color: var(--white);
  margin-top: 40px;
  border-top: 3px solid var(--accent-gold);
  font-size: 0.85rem;
}

/* ==========================================
   Media Queries for Tablets and Desktops
   ========================================== */
@media (min-width: 768px) {
  header {
    padding: 1rem 2rem;
  }
  
  header h1 {
    font-size: 1.4rem;
  }

  header img.police-logo {
    height: 55px;
  }

  .container {
    margin: 40px auto;
    padding: 0 20px;
  }

  .card {
    padding: 30px;
  }

  .card h2 {
    font-size: 1.6rem;
  }

  button, .btn {
    width: auto; /* Revert buttons to inline-block width on larger screens */
  }

  .main-container {
    flex-direction: row; /* Side-by-side view for tablet and desktop */
    justify-content: center;
    padding: 40px 20px;
    gap: 30px;
  }

  .bio-card {
    width: 450px;
    padding: 30px;
    border-radius: 16px;
  }

  .qr-image-box img {
    width: 200px;
    height: 200px;
  }
}

/* ==========================================
   Print / PDF Report Media Styles
   ========================================== */
@media print {
    body {
        background-color: #ffffff !important;
        color: #000000 !important;
        font-family: Arial, sans-serif !important;
    }

    nav, 
    aside, 
    header, 
    .export-buttons-container, 
    .filter-section, 
    button, 
    .print-btn,
    .search-form,
    .dashboard-grid,
    .ai-insights-container {
        display: none !important;
    }

    .database-records-container, .card {
        background: transparent !important;
        box-shadow: none !important;
        border: none !important;
        width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    .table-responsive {
        overflow: visible !important;
    }

    table {
        width: 100% !important;
        border-collapse: collapse !important;
        margin-top: 20px !important;
        min-width: auto !important;
    }

    th, td {
        border: 1px solid #ddd !important;
        padding: 8px 12px !important;
        text-align: left !important;
        color: #000000 !important;
    }

    th {
        background-color: #f4f4f4 !important;
        color: #000000 !important;
        font-weight: bold;
    }

    audio, .text-muted {
        display: none !important;
    }

    @page {
        size: A4;
        margin: 20mm;
    }
}
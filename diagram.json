{
  "version": 1,
  "author": "Etsegenet Indrias",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "simulated-pir-motion-sensor", "id": "pir1", "top": -40, "left": 120, "attrs": {} },
    { "type": "push-button", "id": "btn1", "top": 60, "left": -80, "attrs": { "color": "green" } },
    { "type": "led", "id": "led1", "top": -20, "left": -80, "attrs": { "color": "red" } },
    { "type": "buzzer", "id": "bz1", "top": 120, "left": 120, "attrs": {} }
  ],
  "connections": [
    ["esp:TX0", "$serialMonitor", "rx", []],
    ["esp:RX0", "$serialMonitor", "tx", []],
    ["led1:A", "esp:23", "red", [ "v0" ]],
    ["led1:C", "esp:GND.1", "black", [ "v0" ]],
    ["btn1:1.l", "esp:22", "green", [ "v0" ]],
    ["btn1:2.l", "esp:GND.2", "black", [ "v0" ]]
  ]
}
{
  "version": 1,
  "author": "Etsegenet Indrias",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "sensor-pir", "id": "pir1", "top": -120, "left": -240, "attrs": {} },
    { "type": "component-buzzer", "id": "bz1", "top": 40, "left": 120, "attrs": { "volume": "0.5" } },
    { "type": "led", "id": "ledGreen", "top": -60, "left": 120, "attrs": { "color": "green" } },
    { "type": "led", "id": "ledRed", "top": -120, "left": 120, "attrs": { "color": "red" } }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor", "rx", [] ],
    [ "esp:RX0", "$serialMonitor", "tx", [] ],
    
    [ "pir1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "pir1:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "pir1:OUT", "esp:14", "green", [ "v0" ] ],
    
    [ "ledRed:A", "esp:26", "red", [ "v0" ] ],
    [ "ledRed:C", "esp:GND.2", "black", [ "v0" ] ],
    
    [ "ledGreen:A", "esp:25", "green", [ "v0" ] ],
    [ "ledGreen:C", "esp:GND.3", "black", [ "v0" ] ],
    
    [ "bz1:1", "esp:27", "purple", [ "v0" ] ],
    [ "bz1:2", "esp:GND.4", "black", [ "v0" ] ]
  ]
}